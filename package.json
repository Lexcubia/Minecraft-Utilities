{
  "name": "minecraft-utilities",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Minecraft Utilities: practical tools for Minecraft players (Tauri 2 + Python)",
  "author": "Lexcubia",
  "scripts": {
    "format": "prettier --write \"**/*.{json,yml,yaml,md,mjs,cjs}\" \"*.js\" && prettier --write \"src/**/*.{ts,css}\" \"vite.config.ts\" \"vitest.config.ts\" \"eslint.config.ts\"",
    "format:check": "prettier --check \"**/*.{json,yml,yaml,md,mjs,cjs}\" \"*.js\" && prettier --check \"src/**/*.{ts,css}\" \"vite.config.ts\" \"vitest.config.ts\" \"eslint.config.ts\"",
    "lint": "pnpm lint:md && pnpm lint:app",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "lint:app": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build --ci",
    "tauri:build:portable": "pnpm build && pnpm exec tauri build --ci --no-bundle && node scripts/pack-windows-portable.mjs",
    "desktop:pack:portable": "node scripts/pack-windows-portable.mjs",
    "desktop:pack:linux": "node scripts/pack-linux-tarball.mjs",
    "verify:js": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "desktop:dev": "pnpm dev",
    "desktop:tauri": "pnpm tauri dev",
    "desktop:build": "pnpm build",
    "gen:logo": "node scripts/gen-app-logo-svg.mjs && pnpm exec tauri icon public/app-logo.svg -o src-tauri/icons && node scripts/sync-tauri-bundle-icons-from-config.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.2.5",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/nunito-sans": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.2",
    "marked": "^18.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  }
}

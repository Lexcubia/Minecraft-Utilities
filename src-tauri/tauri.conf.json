{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft-Utilities",
  "mainBinaryName": "minecraft-utilities",
  "version": "0.1.1",
  "identifier": "com.lexcubia.minecraft-utilities",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Utilities",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

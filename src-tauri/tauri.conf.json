{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft-Utilities",
  "mainBinaryName": "minecraft-utilities",
  "version": "0.3.2",
  "identifier": "com.lexcubia.minecraft-utilities",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Utilities",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../src/locales/en.json": "locales/en.json",
      "../src/locales/zh-CN.json": "locales/zh-CN.json",
      "../src/user-data/assets/README.txt": "assets/README.txt",
      "../src/log/README.txt": "logs/README.txt",
      "../src/config/README.txt": "configs/README.txt",
      "../src/config/settings.json": "configs/settings.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

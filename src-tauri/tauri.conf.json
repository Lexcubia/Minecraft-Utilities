{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft-Utilities",
  "mainBinaryName": "minecraft-utilities",
  "version": "0.3.0",
  "identifier": "com.lexcubia.minecraft-utilities",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Utilities",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NjI1M0Q2NzgzMThGMjkKUldRcGp6RjQxbE5pbUhwVFpKK1BDMDk4eThaOHRJUjFyWEQxQ3p5UUJkck5PeDV2dUp5UERrYisK",
      "endpoints": [
        "https://github.com/Lexcubia/Minecraft-Utilities/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
